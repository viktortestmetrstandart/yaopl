+static int udpbd_write(struct block_device *bd, uint64_t sector, const void *buffer, uint16_t count)
+{
+    int retries;
+    uint16_t count_left;
+
+    if (bdm_connected == 0)
+        return -EIO;
+
+    if (sector >= bd->sectorCount)
+        return -EINVAL;
+
+    if ((sector + count) > bd->sectorCount)
+        count = bd->sectorCount - sector;
+
+    count_left = count;
+    while (count_left > 0)
+    {
+        uint16_t count_block = count_left > UDPBD_MAX_SECTOR_WRITE ? UDPBD_MAX_SECTOR_WRITE : count_left;
+
+        for (retries = 0; retries < UDPBD_MAX_RETRIES; retries++)
+        {
+            if (_udpbd_write(bd, sector, buffer, count_block) == count_block)
+                break;
+            DelayThread(1000);
+        }
+
+        if (retries == UDPBD_MAX_RETRIES)
+        {
+            M_DEBUG("%s: too many errors, disconnecting\n", __func__);
+            bdm_disconnect_bd(&g_udpbd);
+            bdm_connected = 0;
+            return -EIO;
+        }
+
+        count_left -= count_block;
+        sector += count_block;
+        buffer = (const uint8_t *)buffer + count_block * g_udpbd.sectorSize;
+    }
+
+    return count;
+}
 
